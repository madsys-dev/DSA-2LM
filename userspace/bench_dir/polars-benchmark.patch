From 38254821c9431b33b8278e24c5edd7864e794c02 Mon Sep 17 00:00:00 2001
From: LRL52 <525687841@qq.com>
Date: Tue, 27 May 2025 17:46:09 +0800
Subject: [PATCH 3/4] add png format for plot

---
 scripts/plot_bars.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/scripts/plot_bars.py b/scripts/plot_bars.py
index ea91713..5f0fd76 100644
--- a/scripts/plot_bars.py
+++ b/scripts/plot_bars.py
@@ -223,6 +223,15 @@ def write_plot_image(fig: Any) -> None:
 
     fig.write_html(path / file_name)
 
+    # Save as PNG with custom width and height
+    file_name_png = f"plot-io-{settings.run.io_type}.png"
+    print(path / file_name_png)
+    
+    # Define custom width and height (in pixels)
+    custom_width = 1200  # Increase this value for wider images
+    custom_height = 800  # Adjust height as necessary
+    
+    fig.write_image(path / file_name_png, format="png", width=custom_width, height=custom_height, scale=2)
 
 if __name__ == "__main__":
     main()
-- 
2.43.5


