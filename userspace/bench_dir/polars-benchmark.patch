From 66f6373a361d09844d97adb341d0901ad27d02ab Mon Sep 17 00:00:00 2001
From: LRL52 <525687841@qq.com>
Date: Tue, 27 May 2025 17:44:55 +0800
Subject: [PATCH 1/4] use conda virtual environment

---
 .gitignore |  1 +
 Makefile   | 40 ++++++++++++++++++++--------------------
 2 files changed, 21 insertions(+), 20 deletions(-)

diff --git a/.gitignore b/.gitignore
index a400bca..8468221 100644
--- a/.gitignore
+++ b/.gitignore
@@ -35,3 +35,4 @@ qgen
 /data/tables/
 /output/
 .env*
+.venv-conda/
diff --git a/Makefile b/Makefile
index be3470f..b254d26 100644
--- a/Makefile
+++ b/Makefile
@@ -2,24 +2,24 @@
 
 PYTHONPATH=
 SHELL=/bin/bash
-VENV=.venv
+VENV=.venv-conda
 VENV_BIN=$(VENV)/bin
 
-.venv:  ## Set up Python virtual environment and install dependencies
-	python3 -m venv $(VENV)
-	$(MAKE) install-deps
+venv:  ## Set up conda virtual environment
+	conda create -p $(VENV) python=3.11.9
 
 .PHONY: install-deps
-install-deps: .venv  ## Install Python project dependencies
+install-deps:  ## Install Python project dependencies
+	$(VENV_BIN)/python -m pip install --upgrade pip
 	$(VENV_BIN)/python -m pip install --upgrade uv
-	$(VENV_BIN)/uv pip install --compile -r requirements.txt
-	$(VENV_BIN)/uv pip install --compile -r requirements-dev.txt
+	$(VENV_BIN)/python -m pip install --cofmpile -r requirements.txt
+	$(VENV_BIN)/python -m pip install --compile -r requirements-dev.txt
 
 .PHONY: bump-deps
-bump-deps: .venv  ## Bump Python project dependencies
+bump-deps:  ## Bump Python project dependencies
 	$(VENV_BIN)/python -m pip install --upgrade uv
-	$(VENV_BIN)/uv pip compile requirements.in > requirements.txt
-	$(VENV_BIN)/uv pip compile requirements-dev.in > requirements-dev.txt
+	$(VENV_BIN)/python -m pip compile requirements.in > requirements.txt
+	$(VENV_BIN)/python -m pip compile requirements-dev.in > requirements-dev.txt
 
 .PHONY: fmt
 fmt:  ## Run autoformatting and linting
@@ -31,7 +31,7 @@ fmt:  ## Run autoformatting and linting
 pre-commit: fmt  ## Run all code quality checks
 
 .PHONY: tables
-tables: .venv  ## Generate data tables
+tables:  ## Generate data tables
 	$(MAKE) -C tpch-dbgen dbgen
 	cd tpch-dbgen && ./dbgen -vf -s $(SCALE_FACTOR) && cd ..
 	mkdir -p "data/tables/scale-$(SCALE_FACTOR)"
@@ -40,41 +40,41 @@ tables: .venv  ## Generate data tables
 	rm -rf data/tables/scale-$(SCALE_FACTOR)/*.tbl
 
 .PHONY: run-polars
-run-polars: .venv  ## Run Polars benchmarks
+run-polars:  ## Run Polars benchmarks
 	$(VENV_BIN)/python -m queries.polars
 
 .PHONY: run-duckdb
-run-duckdb: .venv  ## Run DuckDB benchmarks
+run-duckdb:  ## Run DuckDB benchmarks
 	$(VENV_BIN)/python -m queries.duckdb
 
 .PHONY: run-pandas
-run-pandas: .venv  ## Run pandas benchmarks
+run-pandas:  ## Run pandas benchmarks
 	$(VENV_BIN)/python -m queries.pandas
 
 .PHONY: run-pyspark
-run-pyspark: .venv  ## Run PySpark benchmarks
+run-pyspark:  ## Run PySpark benchmarks
 	$(VENV_BIN)/python -m queries.pyspark
 
 .PHONY: run-dask
-run-dask: .venv  ## Run Dask benchmarks
+run-dask:  ## Run Dask benchmarks
 	$(VENV_BIN)/python -m queries.dask
 
 .PHONY: run-modin
-run-modin: .venv  ## Run Modin benchmarks
+run-modin:  ## Run Modin benchmarks
 	$(VENV_BIN)/python -m queries.modin
 
 .PHONY: run-all
-run-all: run-polars run-duckdb run-pandas run-pyspark run-dask run-modin  ## Run all benchmarks
+run-all: run-polars run-duckdb run-pandas run-dask run-modin  ## Run all benchmarks
 
 .PHONY: plot
-plot: .venv  ## Plot results
+plot:  ## Plot results
 	$(VENV_BIN)/python -m scripts.plot_bars
 
 .PHONY: clean
 clean:  clean-tpch-dbgen clean-tables  ## Clean up everything
 	$(VENV_BIN)/ruff clean
 	@rm -rf .mypy_cache/
-	@rm -rf .venv/
+	# @rm -rf .venv-conda/
 	@rm -rf output/
 	@rm -rf spark-warehouse/
 
-- 
2.43.5


